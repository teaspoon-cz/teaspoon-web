              <script>
                (function() {
                  var loaded = false;
                  document.getElementById('gift-form').addEventListener('focusin', function() {
                    if (loaded) return;
                    loaded = true;
                    window._hcaptchaGiftLoad = function() {
                      hcaptcha.render(document.querySelector('#gift-form .h-captcha'), {
                        sitekey: '59f6c9dc-25b4-4dc8-bd40-276e47a49ede',
                        hl: 'cs'
                      });
                    };
                    var s = document.createElement('script');
                    s.src = 'https://js.hcaptcha.com/1/api.js?onload=_hcaptchaGiftLoad&render=explicit';
                    document.head.appendChild(s);
                  });
                })();
                document.getElementById('gift-form').addEventListener('submit', async function (e) {
                  e.preventDefault();
                  const btn = document.getElementById('gift-submit-btn');
                  const status = document.getElementById('gift-form-status');
                  btn.disabled = true;
                  status.style.display = 'inline';
                  status.textContent = 'Odesílám...';
                  try {
                    const res = await fetch('/api/submit', { method: 'POST', body: new FormData(this) });
                    if (res.ok) {
                      status.textContent = 'Děkujeme! Zpráva byla odeslána.';
                      this.reset();
                    } else {
                      status.textContent = 'Chyba při odesílání. Zkuste to prosím znovu.';
                      btn.disabled = false;
                    }
                  } catch {
                    status.textContent = 'Chyba sítě. Zkuste to prosím znovu.';
                    btn.disabled = false;
                  }
                });
              </script>
