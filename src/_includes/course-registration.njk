            <div class="uvc-main-heading ult-responsive" data-responsive-json-new='{"font-size":"","line-height":""}'
              data-ultimate-target=".uvc-heading.ultimate-heading-5716a0da9432997b h2">
              <h2 style="font-weight:normal;">Přihláška ke kurzům</h2>
            </div>
            <div class="uvc-heading-spacer line_only" style="margin-bottom:1.5em;height:1px;"><span
                class="uvc-headings-line"
                style="border-style:solid;border-bottom-width:1px;border-color:#af1b1d;width:autopx;"></span></div>
